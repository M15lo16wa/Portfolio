---
const links = [
  { href: '#about', label: 'about' },
  { href: '#skills', label: 'skills' },
  { href: '#projects', label: 'projects' },
  { href: '#formation', label: 'formation' },
  { href: '#contact', label: 'contact' },
];
---

<header class="header">
  <div class="wrap header-inner">
    <a href="#top" class="logo mono">root@molowa<span class="cursor">:~$</span></a>
    <nav class="nav mono">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primary cv-btn mono" href={`${import.meta.env.BASE_URL}cv-molowa.pdf`} download>
      ⬇ CV
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: rgba(10, 14, 20, 0.85);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .logo {
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .nav {
    display: flex;
    gap: 28px;
    font-size: 13px;
  }
  .nav a {
    color: var(--text-dim);
  }
  .nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .cv-btn {
    padding: 8px 16px;
    font-size: 13px;
  }
  @media (max-width: 720px) {
    .nav {
      display: none;
    }
  }
</style>
