---
const school = 'École Centrale des Logiciels Libres et de Télécommunication';

const diplomas = [
  {
    title: 'Master 1 en Informatique',
    sub: `Spécialisation Réseaux, Télécommunications, DevOps & Cybersécurité — formation continue · ${school}`,
    years: '2026 – 2027',
    status: 'En cours',
  },
  {
    title: 'Licence en Informatique',
    sub: `Spécialisation Réseaux, Télécommunications, DevOps & Cybersécurité · ${school}`,
    years: '2022 – 2025',
    status: 'Obtenue',
  },
];

const languages = [
  { name: 'Français', level: 'Langue maternelle', pct: 100 },
  { name: 'Anglais', level: 'Notions de base', pct: 35 },
];
---

<section id="formation" class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="section-tag">05</span>
      <h2 class="section-title">Formation &amp; langues</h2>
    </div>

    <div class="grid grid-2">
      <div class="panel">
        <span class="tag">diplômes</span>
        <div class="diploma-list">
          {diplomas.map((d) => (
            <div class="diploma-item">
              <div class="diploma-head">
                <h3 class="formation-title">{d.title}</h3>
                <div class="diploma-meta">
                  <span class="mono diploma-years">{d.years}</span>
                  <span class="badge">
                    <span class={`badge-dot ${d.status === 'En cours' ? 'warn' : ''}`}></span>
                    {d.status}
                  </span>
                </div>
              </div>
              <p class="formation-sub">{d.sub}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="panel">
        <span class="tag">langues</span>
        <div class="lang-list">
          {languages.map((lang) => (
            <div class="lang-row">
              <div class="lang-label">
                <span>{lang.name}</span>
                <span class="mono lang-level">{lang.level}</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill" style={`width:${lang.pct}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .diploma-list {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .diploma-item + .diploma-item {
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .diploma-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .formation-title {
    font-size: 18px;
  }
  .diploma-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .diploma-years {
    font-size: 12px;
    color: var(--text-faint);
  }
  .formation-sub {
    margin-top: 8px;
    font-size: 14px;
  }
  .lang-list {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lang-label {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin-bottom: 6px;
  }
  .lang-level {
    color: var(--text-faint);
    font-size: 12px;
  }
  .bar-track {
    height: 6px;
    border-radius: 100px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 100px;
  }
</style>
