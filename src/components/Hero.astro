<section id="top" class="hero">
  <div class="wrap hero-inner">
    <div class="status-line mono">
      <span class="badge"><span class="badge-dot"></span>disponible pour opportunités</span>
      <span class="badge">📍 Dakar, Sénégal</span>
    </div>

    <h1 class="hero-title">
      Molowa Essonga <span class="accent">Emile Royal</span>
    </h1>

    <p class="hero-role mono">
      &gt; Réseaux &amp; Télécoms · Cybersécurité · DevOps
    </p>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#projects">Voir mes projets</a>
      <a class="btn btn-ghost" href="#contact">Me contacter</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 120px 0 96px;
    border-bottom: 1px solid var(--border);
  }
  .status-line {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .hero-title {
    font-size: clamp(34px, 6vw, 56px);
    max-width: 900px;
  }
  .accent {
    color: var(--accent);
  }
  .hero-role {
    margin-top: 16px;
    color: var(--accent-2);
    font-size: 16px;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
</style>
