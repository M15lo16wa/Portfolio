---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner mono">
    <span>© {year} Molowa Essonga Emile Royal</span>
    <span class="footer-links">
      <a href="https://github.com/M15lo16wa" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:molowaroyalemile@gmail.com">Email</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
    color: var(--text-faint);
  }
  .footer-links {
    display: flex;
    gap: 18px;
  }
  .footer-links a {
    color: var(--text-faint);
  }
  .footer-links a:hover {
    color: var(--accent);
  }
</style>
